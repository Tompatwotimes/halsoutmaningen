# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# No Content-Security-Policy here on purpose: a correct policy needs the
# per-environment Supabase project origin (API + Storage) and is best added
# once the production URL and project are fixed. See docs/DEPLOYMENT.md.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed, immutable build assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
