{
  // Cloudflare Worker — static-assets-only SPA host for the built frontend.
  //
  // This file makes the production Worker configuration reviewable in git
  // instead of living only in the Cloudflare dashboard. It mirrors what
  // docs/DEPLOYMENT.md §1 describes.
  //
  // IMPORTANT — this repo does NOT auto-deploy on push. Production promotion is
  // a manual GitHub Actions run (.github/workflows/deploy-production.yml,
  // workflow_dispatch only) gated by the `production` GitHub Environment. The
  // Cloudflare Workers Builds git integration must be DISCONNECTED for that to
  // hold — see docs/DEPLOYMENT.md §1.6. While that integration is still
  // connected, Cloudflare will keep auto-deploying every push to `main`
  // regardless of this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halsoutmaningen",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    // Any path that is not a built asset is served /index.html with 200 so the
    // React Router client routes (/aktivera, /gruppen, /viktkampen, …) work on
    // direct navigation / refresh. Dashboard equivalent: Worker → Settings →
    // Static Assets → SPA not-found handling. docs/DEPLOYMENT.md §1.3.
    "not_found_handling": "single-page-application",
  },
  // Frontend build-time env (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY /
  // VITE_PUBLIC_SITE_URL) is NOT set here — it is injected at build time by the
  // deploy workflow from GitHub Actions repo variables/secrets, exactly the
  // public values documented in docs/DEPLOYMENT.md §1.4. Never put the Supabase
  // service-role key or any JWT secret in this file or on the Worker.
}
