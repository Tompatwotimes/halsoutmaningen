{
  // Cloudflare Worker — static-assets-only SPA host for the built frontend.
  //
  // This file makes the production Worker configuration reviewable in git
  // instead of living only in the Cloudflare dashboard. It mirrors what
  // docs/DEPLOYMENT.md §1 describes.
  //
  // IMPORTANT — confirmed 2026-09-12 (docs/DEPLOYMENT.md §1.6 postmortem):
  // Cloudflare's configured PRODUCTION branch is `production`, not `main`.
  // Only a push to `production` builds with real VITE_* production variables
  // and serves the public URL. Pushing to `main` still auto-builds a
  // non-production preview (expected to fail to boot — no production env).
  // NEVER manually promote a `main`-origin version. Release by fast-forwarding
  // `production` to a verified `main` SHA. `.github/workflows/deploy-
  // production.yml` is NOT the active release path (no CLOUDFLARE_API_TOKEN /
  // GitHub Environment ever configured for it).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halsoutmaningen",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    // Any path that is not a built asset is served /index.html with 200 so the
    // React Router client routes (/aktivera, /gruppen, /viktkampen, …) work on
    // direct navigation / refresh. Dashboard equivalent: Worker → Settings →
    // Static Assets → SPA not-found handling. docs/DEPLOYMENT.md §1.3.
    "not_found_handling": "single-page-application",
  },
  // Frontend build-time env (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY /
  // VITE_PUBLIC_SITE_URL) is NOT set here — it is set directly on the Worker's
  // Cloudflare Build configuration for the `production` branch (docs/
  // DEPLOYMENT.md §1.4), not via this file or GitHub Actions. Never put the
  // Supabase service-role key or any JWT secret in this file or on the Worker.
}
