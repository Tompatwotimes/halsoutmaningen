# ---------------------------------------------------------------------------
# Local-only secrets for `supabase functions serve`. NEVER commit the real file.
# On the hosted project these are set under Dashboard → Edge Functions → Secrets
# (or `supabase secrets set`), except the three SUPABASE_* values which the
# platform injects automatically.
# ---------------------------------------------------------------------------

# Public origin of the deployed frontend. Used for the invite / password-reset
# email redirect to `${SITE_URL}/aktivera`.
SITE_URL=http://localhost:5173

# Only needed locally — provided automatically in the hosted runtime:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
