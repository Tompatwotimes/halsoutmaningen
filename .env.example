# ---------------------------------------------------------------------------
# Hälsoutmaningen — frontend environment
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Only browser-safe, public Supabase configuration belongs here. These values
# are shipped in the client bundle and protected at runtime by Row Level
# Security — they are NOT secrets, but they are also NOT the service-role key.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key (safe for browsers; RLS enforces access)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NEVER put the following in this project or any frontend env file:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - database connection strings / passwords
#   - JWT signing secrets
# Privileged operations run in Supabase (SQL, RLS, Edge Functions), never in
# the browser. See docs/ARCHITECTURE.md §17-§19 and CLAUDE.md §19.
# ---------------------------------------------------------------------------
